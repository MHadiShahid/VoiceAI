{
  "name": "voice-ai-patient-registration",
  "version": "1.0.0",
  "private": true,
  "description": "Voice AI agent (Vapi + Gemini) that registers patients over the phone, backed by a Node REST API, PostgreSQL (Neon) and a React dashboard.",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "test": "npm test --workspace server",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:seed": "npm run db:seed --workspace server",
    "vapi:setup": "node scripts/setup-vapi.js",
    "recordings:archive": "node scripts/archive-recordings.js"
  }
}

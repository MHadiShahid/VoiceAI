# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# Use the *pooled* connection string from the Neon console (host contains "-pooler").
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ─── Vapi (telephony + STT/TTS orchestration) ─────────────────────────────────
# Private API key from https://dashboard.vapi.ai -> Organization -> API Keys.
# Only used by `npm run vapi:setup`; the running server does not need it.
VAPI_API_KEY=

# Shared secret Vapi sends in the `x-vapi-secret` header on every webhook.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
VAPI_WEBHOOK_SECRET=

# ─── Google Gemini (LLM) ──────────────────────────────────────────────────────
# Free key from https://aistudio.google.com/app/apikey. Registered with Vapi as a
# provider credential by `npm run vapi:setup` (BYOK, billed to your free tier).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# ─── Deployment ───────────────────────────────────────────────────────────────
# Public base URL of the deployed app (no trailing slash). Vapi webhooks go to
# $PUBLIC_BASE_URL/api/vapi/webhook.
PUBLIC_BASE_URL=https://your-app.vercel.app

# Optional: desired area code when `vapi:setup` provisions a free Vapi number.
VAPI_PHONE_AREA_CODE=

# Optional: shown on the dashboard so reviewers know which number to call.
PUBLIC_PHONE_NUMBER=

# ─── Misc ─────────────────────────────────────────────────────────────────────
# Clinic timezone used for the mock appointment schedule.
CLINIC_TIMEZONE=America/New_York
PORT=3001
LOG_LEVEL=info
